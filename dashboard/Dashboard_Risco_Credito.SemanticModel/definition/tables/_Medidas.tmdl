			</div>
			"
			
			
			```
		lineageTag: 823477ce-d920-47b3-8cb4-fdb6e5ba6c67

	measure 'Recall LightGBM' = ```
			
			CALCULATE(
			    MAX('comparativo_modelos_para_powerbi'[Recall]), 
			    'comparativo_modelos_para_powerbi'[Modelo de ML] = "LightGBM"
			)
			
			
			```
