			        color: #888888;        /* Cinza padrão para todos */
			        padding: 8px 0;
			        border-bottom: 3px solid transparent;
			        font-weight: 500;
			        font-size: 14px;
			        cursor: pointer;
			        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
			        text-decoration: none;
			    }
			
			    /* Efeito de destaque: Só ativa quando passa o mouse (ou toca) */
