	measure 'Cor Categoria Risco' = ```
			
			SWITCH(SELECTEDVALUE('predicoes_para_powerbi'[Categoria de Risco]),
			    "Muito Baixo", "#404040",
			    "Baixo", "#5E5E5E",
			    "Moderado", "#8367B8",
			    "Alto", "#A278E1",
			    "Muito Alto", "#E0D1FF",
			    "#1C1C1C"
			)
			
			```
		lineageTag: edd28793-2d44-4a3f-859b-3f0e3a3068e5

	measure 'Média Taxa Juros' = ```
			AVERAGE('predicoes_para_powerbi'[Taxa de Juros (%)]) / 100
			
			
			```
		lineageTag: fae29685-b703-4792-9fdf-3a83defefcfb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cor Tema Categoria Risco Tabela' = ```
			
			SWITCH(SELECTEDVALUE('predicoes_para_powerbi'[Categoria de Risco]),
			    "Muito Alto", "#A278E1",  // Roxo Vibrante (Destaque Máximo para o analista)
			    "Alto", "#8C63C6",        // Roxo Suave
			    "Moderado", "#666666",    // Cinza Médio (Atenção normal)
			    "Baixo", "#444444",       // Cinza Escuro (Tranquilo)
			    "Muito Baixo", "#2A2A2A", // Cinza bem apagado no fundo escuro (Super Seguro)
			    "#666666"                 // Cor padrão caso a categoria venha vazia
			)
			
			```
		lineageTag: 8011efc2-d862-430f-bec3-8d67f920e21f

	measure 'Cor Tema Inadimplencia Anterior tabela' = ```
			
			SWITCH(SELECTEDVALUE('predicoes_para_powerbi'[Histórico de Inadimplência]),
			    "Sim", "#A278E1",  // Roxo do tema (Destaca quem já deu calote no passado)
			    "Não", "#444444",  // Cinza escuro (Deixa "apagado" quem tem o nome limpo)
			    "#666666"          // Cor padrão
			)
			
			```
		lineageTag: 3a070f13-420c-4c99-8ff7-ad9d07c4fa0d

	measure 'Cor Destaque LightGBM' = ```
			
			VAR ModeloSelecionado = SELECTEDVALUE('comparativo_modelos_para_powerbi'[Modelo de ML])
			RETURN
			    IF(
			        ModeloSelecionado = "LightGBM", 
			        "#A278E1",  -- Cor roxa do seu tema para destacar
			        "#141414"   -- Cor de fundo padrão dos outros cartões
			    )
			
			```
		lineageTag: 61bad09c-a7db-4e6a-8e1f-7ef566bf1438

	measure 'Cor Categoria Risco2' = ```
			
			VAR CategoriaAtual = MAX('predicoes_para_powerbi'[Categoria de Risco])
			
			RETURN
			SWITCH(
			    CategoriaAtual,
			    "Muito Alto", "#A278E1",   // Roxo Destaque Principal
			    "Alto", "#8367B8",         // Roxo Médio
			    "Moderado", "#73648A",     // Roxo Acinzentado (Transição)
			    "Baixo", "#5E5E5E",        // Cinza Mantido
			    "Muito Baixo", "#404040",  // Cinza Escuro Mantido
			    "#1C1C1C"                  // Cor padrão de segurança
			)
			
			
			```
		lineageTag: ec5ed844-9522-4519-98ea-ba49220850e3

