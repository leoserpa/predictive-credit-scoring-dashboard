table _Medidas
	lineageTag: c1e1f952-4c08-4bc4-822f-9f09fc8682a1

	measure 'Total de Clientes' = ```
			COUNTROWS('predicoes_para_powerbi')
			
			```
		formatString: 0
		lineageTag: 126c4e75-374d-4b33-843a-ff52745988e9

	measure 'Média de Risco' = ```
			AVERAGE('predicoes_para_powerbi'[Probabilidade de Calote])
			
			```
		lineageTag: 734707b2-27e0-49b5-9ae5-624a19ba5aa5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volume em Risco (R$)' = ```
			
			CALCULATE(
			    SUM('predicoes_para_powerbi'[Valor do Empréstimo]), 
			    'predicoes_para_powerbi'[Inadimplência Prevista (Modelo)] = 1
			)
			
			```
		formatString: 0
		lineageTag: 86950f60-57e7-4ba6-8442-ba3fb5d89de0

	measure '% Inadimplência Prevista' = ```
			
			DIVIDE(
			    CALCULATE(COUNTROWS('predicoes_para_powerbi'), 'predicoes_para_powerbi'[Inadimplência Prevista (Modelo)] = 1),
			    [Total de Clientes],
			    0
			)
			
			```
		lineageTag: bc74db31-bf99-4014-9f51-e420dde8edef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volume Total (R$)' = ```
			SUM('predicoes_para_powerbi'[Valor do Empréstimo])
			
			```
		formatString: 0
		lineageTag: 6b6f7dce-909d-4811-8761-71917bec7143

	measure 'Cor Barra Destaque' = ```
			
			VAR MaiorValorNoFiltro = 
			    MAXX(
			        ALLSELECTED('predicoes_para_powerbi'[Motivo do Empréstimo]), -- Clique aqui e selecione sua tabela
			        [Média de Risco]
			    )
			RETURN
			    IF(
			        [Média de Risco] = MaiorValorNoFiltro, 
			        "#A278E1", 
			        "#444444" 
			    )
			
			
			```
		lineageTag: 129ab01e-5152-40ff-96d6-73a7a8939248

	measure 'Cor Treemap Ranking' = ```
			
			VAR Posicao = 
			    RANKX(
			        ALLSELECTED('predicoes_para_powerbi'[Motivo do Empréstimo]), -- Focamos na categoria
			        CALCULATE(SUM('predicoes_para_powerbi'[Valor do Empréstimo]))
			    )
			RETURN
			    SWITCH( Posicao,
			        1, "#A278E1", -- Roxo Destaque
			        2, "#7456AD", -- Roxo Médio
			        3, "#5E5E5E", -- Cinza
			        4, "#4A4A4A", -- Cinza
			        5, "#363636", -- Grafite
			        "#222222"     -- Fundo
			    )
			
			
			```
		lineageTag: 89f19884-e708-4977-a841-bfe1a481bc84

